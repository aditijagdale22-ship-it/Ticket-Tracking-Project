# Google Sheets database
# 1. Create a Google Cloud service account with Sheets API enabled.
# 2. Share the spreadsheet with the service account email (Editor).
# 3. Copy these into .env or .env.local

GOOGLE_SHEETS_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# Optional: paste the full service-account JSON instead of email + key
# GOOGLE_SERVICE_ACCOUNT_JSON=
